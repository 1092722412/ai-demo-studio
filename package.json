{
  "name": "ai-demo-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:server && tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build && node --experimental-sqlite server/studio.mjs",
    "init:store": "npm run build:server && node --experimental-sqlite dist-server/index.js",
    "test": "npm run build:server && node --experimental-sqlite --test"
  },
  "dependencies": {
    "@fastify/multipart": "9.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "fastify": "^5.12.8",
    "fflate": "0.8.2",
    "lucide-react": "0.554.0",
    "mammoth": "1.11.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
